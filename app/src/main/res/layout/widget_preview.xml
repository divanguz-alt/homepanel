<?xml version="1.0" encoding="utf-8"?>
<!-- Static picker preview for launchers without generated previews (before Android 15). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/preview_card"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Monday, 19 October"
        android:textColor="#A3A9B5"
        android:textSize="16sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="17°  Clear now"
        android:textColor="#ECEEF2"
        android:textSize="40sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="12dp"
        android:background="#262A33" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Coming up"
        android:textColor="#8A909C"
        android:textSize="14sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:lineSpacingExtra="10dp"
        android:text="FRI 23   09:30   Team meeting\nSAT 24   all       Birthday\nSUN 25   20:00   Concert"
        android:textColor="#ECEEF2"
        android:textSize="15sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="12dp"
        android:background="#262A33" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Car\nMain Street 1\n412 km"
            android:textColor="#ECEEF2"
            android:textSize="15sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Claude usage\n5 hours  17%\nWeek  46%"
            android:textColor="#ECEEF2"
            android:textSize="15sp" />
    </LinearLayout>
</LinearLayout>
